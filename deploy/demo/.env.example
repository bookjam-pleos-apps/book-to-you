# deploy/demo/.env로 복사해 채운다. git에 올리지 않는다.
# 비밀번호는 URL에 들어가므로 영숫자만 쓴다: openssl rand -hex 24
POSTGRES_USER=voice_storybook
POSTGRES_PASSWORD=
POSTGRES_DB=voice_storybook
MINIO_ROOT_USER=voice-storybook
MINIO_ROOT_PASSWORD=
# openssl rand -hex 32
AUTH_SECRET=

# ngrok 대시보드 Domains의 무료 고정 도메인 (https:// 없이)
NGROK_DOMAIN=
NGROK_AUTHTOKEN=

# 데모 코드는 숫자 16자리를 4자리씩 하이픈으로 잇는다(NNNN-NNNN-NNNN-NNNN). 심사 안내문에 공개되므로 다른 비밀값과 겹치지 않게 새로 만든다.
# python3 -c "import secrets;d=''.join(secrets.choice('0123456789') for _ in range(16));print('-'.join(d[i:i+4] for i in range(0,16,4)))"
DEMO_PAIRING_CODE=
# demo:export가 출력한 userId
DEMO_USER_ID=
# 이 시각부터 데모 코드 페어링을 거부한다. 예: 2026-12-31T23:59:59+09:00
DEMO_PAIRING_UNTIL=

# 차 QR로 이메일 없이 계정을 만드는 바로 시작하기. 비우면 꺼진다(disabled).
QUICK_START=

# 바로 시작하기 계정의 차량 책장에도 데모 계정의 게시된 동화를 함께 보여 준다(듣기만). 비우면 꺼진다(disabled).
DEMO_SHARED_SHELF=
