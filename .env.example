# 로컬 개발 전용. `cp .env.example .env` 후 값을 바꾼다. .env는 커밋하지 않는다.
POSTGRES_USER=voice_storybook
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=voice_storybook
MINIO_ROOT_USER=voice-storybook
MINIO_ROOT_PASSWORD=change-me-local-only
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://voice_storybook:change-me-local-only@127.0.0.1:5432/voice_storybook
PUBLIC_ORIGIN=http://localhost:5173
AUTH_SECRET=change-me-local-only-at-least-32-characters
TRUST_PROXY=false
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=voice-storybook

# 전사와 렌더를 맡는 GPU 서비스. 비우면 녹음은 checking으로 남고 동의가 활성화되지 않는다.
# 맥에서는 ssh -L 18090:127.0.0.1:18090 <GPU 장비>로 연결한다.
COMPOSE_URL=http://127.0.0.1:18090/api/workflows/runs

# otp 또는 disabled. 시연 서버처럼 부모 로그인이 필요 없으면 disabled로 메일 없이 기동한다.
LOGIN_MODE=otp

# enabled 또는 disabled. 차 QR로 이메일 없이 계정을 만든다. 누구나 계정을 만들 수 있어 심사처럼 필요한 배포에서만 켠다.
QUICK_START=disabled
